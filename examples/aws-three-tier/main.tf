# Generated by the jhooq.com VPC Subnet Planner - https://jhooq.com/tools/vpc-subnet-planner/
# Every subnet is derived with cidrsubnet() so a reviewer can verify the maths from the VPC CIDR alone.

terraform {
  required_providers {
    aws = { source = "hashicorp/aws", version = ">= 5.0" }
  }
}

variable "name" { default = "jhooq-vpc" }
variable "region" { default = "eu-central-1" }

provider "aws" { region = var.region }

data "aws_availability_zones" "available" {
  state = "available"
}

locals {
  vpc_cidr = "10.0.0.0/16"
  azs      = slice(data.aws_availability_zones.available.names, 0, 3)

  # name => { cidr, az index, tier, public }
  subnets = {
    "private-a"  = { cidr = cidrsubnet(local.vpc_cidr, 4, 0), az = 0, tier = "private", role = "private", public = false } # 10.0.0.0/20
    "private-b"  = { cidr = cidrsubnet(local.vpc_cidr, 4, 1), az = 1, tier = "private", role = "private", public = false } # 10.0.16.0/20
    "private-c"  = { cidr = cidrsubnet(local.vpc_cidr, 4, 2), az = 2, tier = "private", role = "private", public = false } # 10.0.32.0/20
    "public-a"   = { cidr = cidrsubnet(local.vpc_cidr, 8, 64), az = 0, tier = "public", role = "public", public = true }   # 10.0.64.0/24
    "public-b"   = { cidr = cidrsubnet(local.vpc_cidr, 8, 65), az = 1, tier = "public", role = "public", public = true }   # 10.0.65.0/24
    "public-c"   = { cidr = cidrsubnet(local.vpc_cidr, 8, 66), az = 2, tier = "public", role = "public", public = true }   # 10.0.66.0/24
    "database-a" = { cidr = cidrsubnet(local.vpc_cidr, 8, 68), az = 0, tier = "database", role = "data", public = false }  # 10.0.68.0/24
    "database-b" = { cidr = cidrsubnet(local.vpc_cidr, 8, 69), az = 1, tier = "database", role = "data", public = false }  # 10.0.69.0/24
    "database-c" = { cidr = cidrsubnet(local.vpc_cidr, 8, 70), az = 2, tier = "database", role = "data", public = false }  # 10.0.70.0/24
  }
}

resource "aws_vpc" "this" {
  cidr_block           = local.vpc_cidr
  enable_dns_support   = true
  enable_dns_hostnames = true
  tags                 = { Name = var.name }
}

resource "aws_subnet" "this" {
  for_each                = local.subnets
  vpc_id                  = aws_vpc.this.id
  cidr_block              = each.value.cidr
  availability_zone       = local.azs[each.value.az]
  map_public_ip_on_launch = each.value.public
  tags                    = { Name = "${var.name}-${each.key}", Tier = each.value.tier }
}

# ---------- routing ----------
resource "aws_internet_gateway" "this" {
  vpc_id = aws_vpc.this.id
  tags   = { Name = "${var.name}-igw" }
}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.this.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.this.id
  }
  tags = { Name = "${var.name}-public-rt" }
}

resource "aws_route_table_association" "public" {
  for_each       = { for k, s in local.subnets : k => s if s.role == "public" }
  subnet_id      = aws_subnet.this[each.key].id
  route_table_id = aws_route_table.public.id
}

# one NAT gateway per zone, in that zone's public subnet
resource "aws_eip" "nat" {
  for_each = toset([for k, s in local.subnets : tostring(s.az) if s.role == "public"])
  domain   = "vpc"
}

resource "aws_nat_gateway" "this" {
  for_each      = aws_eip.nat
  allocation_id = each.value.id
  subnet_id     = [for k, s in local.subnets : aws_subnet.this[k].id if s.role == "public" && tostring(s.az) == each.key][0]
  tags          = { Name = "${var.name}-nat-${each.key}" }
}

resource "aws_route_table" "private" {
  for_each = aws_nat_gateway.this
  vpc_id   = aws_vpc.this.id
  route {
    cidr_block     = "0.0.0.0/0"
    nat_gateway_id = each.value.id
  }
  tags = { Name = "${var.name}-private-rt-${each.key}" }
}

resource "aws_route_table_association" "private" {
  for_each       = { for k, s in local.subnets : k => s if s.role == "private" }
  subnet_id      = aws_subnet.this[each.key].id
  route_table_id = aws_route_table.private[tostring(each.value.az)].id
}

# isolated / database / transit tiers get a route table with no default route
resource "aws_route_table" "isolated" {
  vpc_id = aws_vpc.this.id
  tags   = { Name = "${var.name}-isolated-rt" }
}

resource "aws_route_table_association" "isolated" {
  for_each       = { for k, s in local.subnets : k => s if contains(["isolated", "data", "transit"], s.role) }
  subnet_id      = aws_subnet.this[each.key].id
  route_table_id = aws_route_table.isolated.id
}

# free gateway endpoints - S3 and DynamoDB traffic skips the NAT gateway
resource "aws_vpc_endpoint" "s3" {
  vpc_id            = aws_vpc.this.id
  service_name      = "com.amazonaws.${var.region}.s3"
  vpc_endpoint_type = "Gateway"
  route_table_ids   = concat([aws_route_table.isolated.id], values(aws_route_table.private)[*].id)
}

output "vpc_id" { value = aws_vpc.this.id }
output "subnet_ids" { value = { for k, s in aws_subnet.this : k => s.id } }

# Unallocated, aligned blocks kept for growth:
#   10.0.72.0/21  (2,048 addresses)
#   10.0.80.0/20  (4,096 addresses)
#   10.0.96.0/19  (8,192 addresses)
#   10.0.128.0/17  (32,768 addresses)
